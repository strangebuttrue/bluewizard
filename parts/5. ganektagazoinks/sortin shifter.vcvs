{
  "modules": [
    {
      "id": 3843294018355055,
      "plugin": "StochasticTelegraph",
      "model": "Fermata",
      "version": "2.0.30",
      "params": [],
      "rightModuleId": 3208280118270841,
      "data": {
        "text": "the SORTIN' SHIFTER\n===============\nThis is a device that uses a SHIFT REGISTER to sample a signal, bundle some number of these samples with another source (static voltage, oscillation, whatever) via MRG8, and sort them, high to low, into interdependent but not parallel streams. \n\nDifferent kinds of inputs (periodic, chaotic, static) will cause it to behave in all sorts of different ways. The order that cables are plugged into the MRG8 doesn't matter, but how many, and which ones, does. Tap any signal, or group of signals, from the SPLT8 - they'll never be quite identical.",
        "width": 3,
        "screen_colors": 1095216660480,
        "font_choice": "fonts/RobotoMono-Medium.ttf",
        "visible_lines": 28,
        "title_text": "SORTIN' SHIFTER"
      },
      "pos": [
        2,
        0
      ]
    },
