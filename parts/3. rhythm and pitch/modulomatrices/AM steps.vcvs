  "modules": [
    {
      "id": 8153042204438283,
      "plugin": "StochasticTelegraph",
      "model": "Fermata",
      "version": "2.0.30",
      "params": [],
      "rightModuleId": 6013129434183822,
      "data": {
        "text": "AM STEPS\n========\n\nThe concept here is yet another STEPAROUND  but using a pair of ring-modulated sawtooth waves.\n\nThe RM'd sawtooth signal passes to a CMP to make triggers. Triggers pass to a S&H that samples from a XFADE combining the two original sawtooths. The sampled voltage and triggers are interdependent!",
        "width": 3,
        "screen_colors": 281200098803712,
        "font_choice": "fonts/RobotoMono-Bold.ttf",
        "visible_lines": 28,
        "title_text": "AM STEPS"
      },
      "pos": [
        98,
        3
      ]
    },
