    {
      "id": 6451790525765859,
      "plugin": "StochasticTelegraph",
      "model": "Fermata",
      "version": "2.0.28",
      "params": [],
      "rightModuleId": 1542858849310038,
      "data": {
        "text": "DEFACTORY 2RFM\n================\n\nThis is a DEFACTORY featuring reciprocal frequency modulation of its oscillator pair. The magic is in the two DIVIDERs - set these to enigmatic ratios and watch them cross-sample each other. FM feedback won't hurt you. It just makes the pattern more fun. Try using a comparator on the output to turn it into a semi-regular gate. Use this to sample the other semi-regular oscillator. Even more semi-regular patterns emerge..",
        "width": 3,
        "screen_colors": 281200098803712,
        "font_choice": "fonts/RobotoSlab-Regular.ttf",
        "visible_lines": 28,
        "title_text": "DEFACTORY 2RFM"
      },
      "pos": [
        173,
        2
      ]
    }
