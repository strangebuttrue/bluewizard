      "model": "Fermata",
      "version": "2.0.17",
      "params": [],
      "rightModuleId": 6874707302965441,
      "data": {
        "text": "The 12 Just Tones\n=================\n\nThis device outputs 12 voltages of stacked Pythagorean fifths, from Ab around to C#. Be aware of where this puts your comma, and use FUNC to transpose around by fifths, if you want it someplace else. Run it into a COERCE for nice quantization.\n\nDesigned for use with Ableton, which won't record unquantized pitches, apparently",
        "width": 3,
        "screen_colors": 1095216660480,
        "font_choice": "fonts/RobotoMono-Bold.ttf",
        "title_text": "The 12 Just Tones"
      },
      "pos": [
        -40,
        -1
      ]
    },
